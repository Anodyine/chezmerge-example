#!/usr/bin/env bash
{{ if eq .chezmoi.hostname "ml-server" -}}
# Extension list hash: {{ include "code-server-extensions.list" | sha256sum }}
# VS Code settings hash: {{ include "dot_config/Code/User/settings.json" | sha256sum }}

set -euo pipefail

info() { printf "\033[1;32m[INFO]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[WARN]\033[0m %s\n" "$*" >&2; }
err()  { printf "\033[1;31m[ERR ]\033[0m %s\n" "$*" >&2; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    err "Missing command: $1"
    exit 1
  }
}

ensure_code_server_installed() {
  if command -v code-server >/dev/null 2>&1; then
    info "code-server already installed: $(command -v code-server)"
    return
  fi

  local aur_helper=""
  if command -v yay >/dev/null 2>&1; then
    aur_helper="yay"
  elif command -v paru >/dev/null 2>&1; then
    aur_helper="paru"
  else
    warn "No AUR helper found. Attempting to install yay from configured pacman repos."
    sudo pacman -S --needed --noconfirm yay || true
    if command -v yay >/dev/null 2>&1; then
      aur_helper="yay"
    fi
  fi

  if [ -z "$aur_helper" ]; then
    err "Cannot install code-server because neither yay nor paru is available."
    exit 1
  fi

  info "Installing code-server via $aur_helper."
  "$aur_helper" -S --needed --noconfirm code-server
}

extract_existing_password() {
  local config_file="$1"

  [ -f "$config_file" ] || return 1

  local password
  password="$(sed -n 's/^[[:space:]]*password:[[:space:]]*//p' "$config_file" | tail -n 1)"
  [ -n "$password" ] || return 1

  password="${password#\'}"
  password="${password%\'}"
  password="${password#\"}"
  password="${password%\"}"
  printf '%s\n' "$password"
}

generate_password() {
  need_cmd openssl
  openssl rand -hex 24
}

yaml_single_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

read_list() {
  local file="$1"

  [ -f "$file" ] || return 1
  sed -e 's/#.*$//' -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//' -e '/^$/d' "$file"
}

write_config() {
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/code-server"
  local config_file="$config_dir/config.yaml"
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"
  local password_file="$state_dir/code-server-password"
  local password=""

  install -d -m 700 "$config_dir" "$state_dir"

  if [ -s "$password_file" ]; then
    password="$(cat "$password_file")"
  elif password="$(extract_existing_password "$config_file")"; then
    :
  else
    password="$(generate_password)"
    info "Generated a new code-server password."
  fi

  printf '%s\n' "$password" > "$password_file"
  chmod 600 "$password_file"

  umask 077
  {
    printf 'bind-addr: 0.0.0.0:8080\n'
    printf 'auth: password\n'
    printf 'password: '
    yaml_single_quote "$password"
    printf '\n'
    printf 'cert: false\n'
  } > "$config_file"
  chmod 600 "$config_file"

  info "Wrote $config_file with bind-addr 0.0.0.0:8080."
  info "Stored the generated password at $password_file."
}

enable_linger() {
  command -v loginctl >/dev/null 2>&1 || return 0

  local linger=""
  linger="$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)"
  if [ "$linger" = "yes" ]; then
    info "systemd user lingering is already enabled for $USER."
    return
  fi

  if sudo loginctl enable-linger "$USER"; then
    info "Enabled systemd user lingering for $USER."
  else
    warn "Could not enable lingering. code-server will still start for login sessions."
  fi
}

enable_service() {
  need_cmd systemctl

  systemctl --user daemon-reload
  systemctl --user reset-failed code-server.service >/dev/null 2>&1 || true
  systemctl --user enable code-server.service
  systemctl --user restart code-server.service
  info "Enabled and restarted code-server.service."
}

sync_vscode_user_config() {
  local source_user_dir="{{ .chezmoi.sourceDir }}/dot_config/Code/User"
  local target_user_dir="${XDG_DATA_HOME:-$HOME/.local/share}/code-server/User"
  local file

  install -d -m 700 "$target_user_dir"

  if [ -f "$source_user_dir/settings.json" ]; then
    if command -v python3 >/dev/null 2>&1; then
      python3 - "$source_user_dir/settings.json" "$target_user_dir/settings.json" <<'PY'
import json
import sys
from pathlib import Path

source = Path(sys.argv[1])
target = Path(sys.argv[2])

with source.open("r", encoding="utf-8") as handle:
    settings = json.load(handle)

settings["workbench.colorTheme"] = "Dracula Midnight"

with target.open("w", encoding="utf-8") as handle:
    json.dump(settings, handle, indent=2)
    handle.write("\n")
PY
      chmod 600 "$target_user_dir/settings.json"
      info "Synced VS Code User/settings.json to code-server with browser theme overrides."
    else
      install -m 600 "$source_user_dir/settings.json" "$target_user_dir/settings.json"
      warn "python3 not found; synced settings.json without code-server theme override."
    fi
  fi

  for file in keybindings.json; do
    if [ -f "$source_user_dir/$file" ]; then
      install -m 600 "$source_user_dir/$file" "$target_user_dir/$file"
      info "Synced VS Code User/$file to code-server."
    fi
  done

  if [ -d "$source_user_dir/snippets" ]; then
    install -d -m 700 "$target_user_dir/snippets"
    find "$source_user_dir/snippets" -maxdepth 1 -type f -print0 | while IFS= read -r -d '' snippet; do
      install -m 600 "$snippet" "$target_user_dir/snippets/$(basename "$snippet")"
    done
    info "Synced VS Code snippets to code-server."
  fi
}

install_code_server_extensions() {
  local list_file="{{ .chezmoi.sourceDir }}/code-server-extensions.list"
  local ext
  local installed_file
  local -a failed=()

  if [ ! -f "$list_file" ]; then
    warn "No VS Code extension list found at $list_file. Skipping code-server extensions."
    return
  fi

  installed_file="$(mktemp)"

  code-server --list-extensions 2>/dev/null | sort -u > "$installed_file" || true

  while IFS= read -r ext; do
    if grep -qxF "$ext" "$installed_file"; then
      info "code-server extension already installed: $ext"
      continue
    fi

    info "Installing code-server extension: $ext"
    if code-server --force --install-extension "$ext"; then
      code-server --list-extensions 2>/dev/null | sort -u > "$installed_file" || true
    else
      failed+=("$ext")
      warn "Could not install code-server extension: $ext"
    fi
  done < <(read_list "$list_file")

  if [ "${#failed[@]}" -gt 0 ]; then
    warn "Some code-server extensions were not installed: ${failed[*]}"
  else
    info "code-server extensions match $list_file."
  fi

  rm -f "$installed_file"
}

main() {
  ensure_code_server_installed
  write_config
  sync_vscode_user_config
  install_code_server_extensions
  enable_linger
  enable_service
}

main "$@"
{{ else -}}
exit 0
{{ end -}}
