#!/usr/bin/env bash

# -----------------------------------------------------------------------------
# CHEZMOI TRIGGERS
# This script reruns when its contents change. It complements packages.pacman.list
# by initializing user-scoped tools installed through rustup/cargo.
# -----------------------------------------------------------------------------

set -euo pipefail

info() { printf "\033[1;32m[INFO]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[WARN]\033[0m %s\n" "$*"; }

ensure_rust_toolchain() {
  if ! command -v rustup >/dev/null 2>&1; then
    warn "rustup is not available yet. Run chezmoi apply again after package installation completes."
    return
  fi

  if rustup show active-toolchain >/dev/null 2>&1; then
    info "Rust toolchain already configured: $(rustup show active-toolchain)"
  else
    info "Installing Rust stable toolchain for Tauri development."
    rustup default stable
  fi
}

ensure_tauri_driver() {
  if command -v tauri-driver >/dev/null 2>&1; then
    info "tauri-driver already installed: $(command -v tauri-driver)"
    return
  fi

  if ! command -v cargo >/dev/null 2>&1; then
    warn "cargo is not available yet. Run chezmoi apply again after rustup initializes Rust."
    return
  fi

  info "Installing tauri-driver for future Tauri WebDriver tests."
  cargo install tauri-driver --locked
}

main() {
  ensure_rust_toolchain
  ensure_tauri_driver

  if command -v node >/dev/null 2>&1 && command -v pnpm >/dev/null 2>&1; then
    info "Node.js ready: $(node --version), pnpm $(pnpm --version)"
  else
    warn "node/pnpm are not available yet. They should be installed from packages.pacman.list."
  fi
}

main "$@"
