#!/usr/bin/env bash
set -Eeuo pipefail

info() { printf "\033[1;32m[INFO]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[WARN]\033[0m %s\n" "$*"; }
err()  { printf "\033[1;31m[ERR ]\033[0m %s\n" "$*" >&2; }

repo_url="https://github.com/ilysenko/codex-desktop-linux.git"
repo_dir="{{ .chezmoi.homeDir }}/repos/codex-desktop-linux"
app_start="$repo_dir/codex-app/start.sh"
state_dir="${XDG_STATE_HOME:-{{ .chezmoi.homeDir }}/.local/state}/chezmoi"
marker="$state_dir/codex-desktop-linux.last-refresh"
interval_days="${CODEX_DESKTOP_UPDATE_INTERVAL_DAYS:-1}"
force="${CODEX_DESKTOP_FORCE_UPDATE:-0}"

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    err "Missing command: $1"
    exit 1
  }
}

marker_is_stale() {
  [ -f "$marker" ] || return 0

  case "$interval_days" in
    ''|*[!0-9]*)
      warn "Invalid CODEX_DESKTOP_UPDATE_INTERVAL_DAYS=$interval_days; using 1"
      interval_days=1
      ;;
  esac

  local now last max_age
  now="$(date +%s)"
  last="$(stat -c %Y "$marker" 2>/dev/null || printf '0')"
  max_age="$((interval_days * 86400))"

  [ "$((now - last))" -ge "$max_age" ]
}

run_install() {
  info "Refreshing Codex Desktop Linux from latest upstream DMG"
  (
    cd "$repo_dir"
    ./install.sh --fresh
  )
  date -u '+%Y-%m-%dT%H:%M:%SZ' > "$marker"
}

need_cmd git
need_cmd date
need_cmd stat
mkdir -p "$(dirname "$repo_dir")" "$state_dir"

old_head=""
if [ -d "$repo_dir/.git" ]; then
  old_head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"
  if ! git -C "$repo_dir" pull --ff-only; then
    if [ -x "$app_start" ]; then
      warn "Could not update $repo_dir; keeping existing Codex Desktop install"
      exit 0
    fi
    err "Could not update $repo_dir and no existing Codex Desktop install is present"
    exit 1
  fi
elif [ -e "$repo_dir" ]; then
  err "$repo_dir exists but is not a git checkout"
  exit 1
else
  info "Cloning Codex Desktop Linux"
  git clone "$repo_url" "$repo_dir"
fi

new_head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || true)"

needs_install=0
reason=""
if [ "$force" = "1" ]; then
  needs_install=1
  reason="forced by CODEX_DESKTOP_FORCE_UPDATE=1"
elif [ ! -x "$app_start" ]; then
  needs_install=1
  reason="app is not installed"
elif [ -n "$old_head" ] && [ -n "$new_head" ] && [ "$old_head" != "$new_head" ]; then
  needs_install=1
  reason="installer checkout changed"
elif marker_is_stale; then
  needs_install=1
  reason="refresh interval elapsed"
fi

if [ "$needs_install" -eq 1 ]; then
  info "Codex Desktop rebuild needed: $reason"
  if ! run_install; then
    if [ -x "$app_start" ]; then
      warn "Codex Desktop refresh failed; keeping existing install"
      exit 0
    fi
    err "Codex Desktop install failed and no existing install is present"
    exit 1
  fi
else
  info "Codex Desktop Linux is current"
fi
