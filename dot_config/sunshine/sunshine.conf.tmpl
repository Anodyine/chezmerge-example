{{ if eq .chezmoi.hostname "arch-surface" -}}
adapter_name = /dev/dri/renderD128
capture = kms
encoder = vaapi
kms_device = /dev/dri/card1
output_name = 1
stream_audio = disabled
{{ else if eq .chezmoi.hostname "arch-lenovo" -}}
adapter_name = /dev/dri/renderD128
capture = kms
encoder = nvenc
kms_device = /dev/dri/card1
nvenc_preset = 7
nvenc_twopass = full_res
{{ else if eq .chezmoi.hostname "ml-server" -}}
capture = kms
encoder = nvenc
nvenc_preset = 7
nvenc_twopass = full_res
adapter_name = /dev/dri/renderD129
{{ end }}
