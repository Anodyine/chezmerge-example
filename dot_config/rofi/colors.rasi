* {
    background: rgba(46, 48, 61, 0.7);
    selection: rgba(96, 101, 121, 0.7);
    highlight: @selection;
    primary: #d649ae;
    primary-fixed: #d649ae;
    primary-fixed-dim: #d649ae;
    on-primary: #241523;
    on-primary-fixed: #241523;
    on-primary-fixed-variant: #241523;
    primary-container: #d649ae;
    on-primary-container: #241523;
    secondary: #b7c9d9;
    secondary-fixed: #d3e5f5;
    secondary-fixed-dim: #b7c9d9;
    on-secondary: #22323f;
    on-secondary-fixed: #0c1d29;
    on-secondary-fixed-variant: #384956;
    secondary-container: #384956;
    on-secondary-container: #d3e5f5;
    tertiary: #cfc0e8;
    tertiary-fixed: #eaddff;
    tertiary-fixed-dim: #cfc0e8;
    on-tertiary: #352b4b;
    on-tertiary-fixed: #201634;
    on-tertiary-fixed-variant: #4c4162;
    tertiary-container: #4c4162;
    on-tertiary-container: #eaddff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #2e303d;
    on-surface: #e0e3e8;
    on-surface-variant: #c1c7ce;
    outline: #8b9198;
    outline-variant: #41474d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e0e3e8;
    inverse-on-surface: #2d3135;
    inverse-primary: #d649ae;
    surface-dim: #2e303d;
    surface-bright: #363a3e;
    surface-container-lowest: #0b0f12;
    surface-container-low: #181c20;
    surface-container: #1c2024;
    surface-container-high: #262a2e;
    surface-container-highest: #313539;
}
