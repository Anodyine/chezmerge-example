{
  "update.mode": "none", 
  "workbench.colorTheme": "Dracula Darcula",
  "vim.handleKeys": {
      "<C-c>": false,
      "<C-v>": false,
      "<C-a>": false,
      "<C-x>": false,
      "<C-p>": false,
      "<C-f>": false,
      "<C-z>": false
  },
  "keyboard.dispatch": "keyCode",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "vscode_custom_css.imports": [
    "file:///home/anodyine/.config/Code/animations/updateHandler.js"
  ],
  "animations.Enabled": true,
  "animations.Install-Method": "Custom CSS and JS",
  "animations.CursorAnimationOptions": {
    "TrailLength": 6 
  },
  "animations.CursorAnimation": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.external.linuxExec": "kitty",
  "terminal.explorerKind": "external",
  "workbench.iconTheme": "Dracula Darcula Icons",
  "python.analysis.typeCheckingMode": "standard",
  "editor.fontSize": 16,
  "files.associations": {
    "*.tmpl": "gotmpl"
  },
  "gopls": {
    "ui.semanticTokens": true,
    "templateExtensions": ["tmpl", "gohtml"]
  },
  "[gotmpl]": {
      "editor.semanticHighlighting.enabled": true
  },
  "python.defaultInterpreterPath": "/sbin/python3.14",
  "explorer.confirmPasteNative": false,
  "git.enableSmartCommit": true,
  "editor.fontFamily": "'Symbols Nerd Font Mono', 'JetBrainsMono Nerd Font', 'FiraCode Nerd Font', monospace",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (xelatex)",
      "tools": ["latexmk_xelatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk_xelatex",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],
  "workbench.colorCustomizations": {
    "editor.background": "#1e1f28",
    "welcomePage.background": "#1e1f28",
    "sideBar.background": "#181922",
    "activityBar.background": "#14151d",
    "statusBar.background": "#14151d",
    "titleBar.activeBackground": "#14151d",
    "titleBar.inactiveBackground": "#101118",
    "menubar.selectionBackground": "#2a1f2a",
    "menubar.selectionForeground": "#f5e9f2",

    "editorGroupHeader.tabsBackground": "#101118",
    "editorGroupHeader.noTabsBackground": "#101118",

    "tab.activeBackground": "#181922",
    "tab.inactiveBackground": "#14151d",
    "tab.unfocusedActiveBackground": "#181922",
    "tab.unfocusedInactiveBackground": "#14151d",
    "tab.activeForeground": "#f5e9f2",
    "tab.inactiveForeground": "#9ea0aa",
    "tab.border": "#14151d",

    "panel.background": "#101118",
    "panel.border": "#14151d",
    "panelTitle.activeBorder": "#d649ae",
    "panelTitle.activeForeground": "#f5e9f2",
    "panelTitle.inactiveForeground": "#9ea0aa",

    "terminal.background": "#101118",

    "breadcrumb.background": "#181922",
    "editorLineNumber.background": "#1e1f28",

    "sideBarTitle.background": "#181922",
    "sideBarSectionHeader.background": "#14151d",
    "sideBarSectionHeader.border": "#14151d",

    "list.inactiveSelectionBackground": "#2a1f2a",
    "list.activeSelectionBackground": "#3a2340",
    "list.hoverBackground": "#221a2a"
  }
}
